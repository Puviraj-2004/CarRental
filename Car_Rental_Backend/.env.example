# =================================================================
# Car Rental Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
LOG_LEVEL=debug

# ── Localisation ─────────────────────────────────────────────────
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr-FR
APP_CURRENCY=EUR

# ── Company ──────────────────────────────────────────────────────
# Used in transactional emails, invoices, and receipts.
COMPANY_NAME=My Car Rental
COMPANY_EMAIL=contact@mycarrental.com

# ── Booking Rules ────────────────────────────────────────────────
# Hours before booking start time within which cancellation is allowed.
BOOKING_CANCELLATION_WINDOW_HOURS=24

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/car_rental_db

# ── Auth ─────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters
JWT_SECRET=

# ── Redis (required in production) ───────────────────────────────
REDIS_URL=redis://localhost:6379


# ── Cloudinary ───────────────────────────────────────────────────

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Set to true in development to skip real Stripe calls
MOCK_STRIPE=true

# ── Seed ─────────────────────────────────────────────────────────
# Admin account created by `prisma db seed`. Change before first run.
SEED_ADMIN_EMAIL=admin@mycarrental.com
SEED_ADMIN_PASSWORD=Admin@123456

# ── Email (Resend) ──────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_
# From address — requires a verified domain in production.
# Without a domain, use onboarding@resend.dev (dev/testing only).
RESEND_FROM=onboarding@resend.dev

# ── Google OAuth ─────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=

# ── Gemini AI (OCR) ──────────────────────────────────────────────
GEMINI_API_KEY=

# Booking
RESERVATION_HOLD_MINUTES=30
PAYMENT_EXPIRY_HOURS=24
CANCELLATION_WINDOW_HOURS=24

# Refund policy
FULL_REFUND_MIN_HOURS=72
PARTIAL_REFUND_MIN_HOURS=24
PARTIAL_REFUND_PCT=0.80


