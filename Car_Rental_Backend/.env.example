# ==============================================================
# Car Rental Backend — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ==============================================================

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Database (Prisma) ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/car_rental_db?schema=public"

# ── Authentication ─────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-min-32-chars"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── Email (SMTP / Gmail App Password) ────────────────────────
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# ── AI / OCR (Google Gemini) ──────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Cloudinary (Image Storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or use the combined URL format:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Stripe (Payments) ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
MOCK_STRIPE=false

# ── Redis (Required in production for OTP, CSRF, rate limiting)
# Option A: Connection URL
# REDIS_URL=redis://localhost:6379
# Option B: Individual fields
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=