generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  RESERVED
  RENTED
  UNAVAILABLE
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingType {
  RENTAL
  COURTESY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PaymentMethod {
  id       String    @id @default(uuid())
  name     String    @unique
  payments Payment[]
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password      String?
  emailVerified Boolean     @default(false)
  role          Role        @default(USER)
  documents     Documents?
  bookings      Booking[]

  @@index([email])
}

model Documents {
  id              String             @id @default(uuid())
  userId          String?            @unique
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId       String?            @unique
  booking         Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  licenseFrontUrl String?
  licenseBackUrl  String?
  idCardFrontUrl  String?
  idCardBackUrl   String?
  addressProofUrl String?

  licenseNumber   String?
  licenseExpiry   DateTime?
  age             Int?
  idNumber        String?
  idExpiry        DateTime?
  address         String?

  status          VerificationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([status])
}

model FuelType {
  id   String @id @default(uuid())
  name String @unique
  cars Car[]
}

model Brand {
  id     String         @id @default(uuid())
  name   String         @unique
  models VehicleModel[]
}

model VehicleModel {
  id      String @id @default(uuid())
  name    String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cars    Car[]

  @@unique([name, brandId])
}

model Car {
  id              String       @id @default(uuid())
  modelId         String
  model           VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  plateNumber     String       @unique
  fuelTypeId      String?
  fuelType        FuelType?    @relation(fields: [fuelTypeId], references: [id], onDelete: SetNull)
  basePrice       Decimal @db.Decimal(10,2)
  status          CarStatus    @default(AVAILABLE)
  primaryImageUrl String       @default("")
  images          CarImage[]
  bookings        Booking[]

  @@index([status])
  @@index([modelId])
  @@index([fuelTypeId])
  @@index([basePrice])
}

model CarImage {
  id    String @id @default(uuid())
  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  url   String
}

model Booking {
  id           String        @id @default(uuid())
  userId       String?
  carId        String
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  car          Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  numberOfDays Int
  basePrice    Decimal       @default(0) @db.Decimal(10, 2)
  totalPrice   Decimal       @default(0) @db.Decimal(10, 2)
  guestName    String?
  guestPhone   String?
  notes        String?
  status       BookingStatus @default(RESERVED)
  type         BookingType   @default(RENTAL)
  documents    Documents?
  payment      Payment?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([startDate])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal @db.Decimal(10,2)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status          PaymentStatus  @default(PENDING)
  stripeId        String?        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
